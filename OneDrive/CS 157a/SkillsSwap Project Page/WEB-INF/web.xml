<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SkillSwap Campus</display-name>

    <!-- Servlet mappings -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.skillswap.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.skillswap.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.skillswap.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteAccountServlet</servlet-name>
        <servlet-class>com.skillswap.DeleteAccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteAccountServlet</servlet-name>
        <url-pattern>/deleteAccount</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateProfileServlet</servlet-name>
        <servlet-class>com.skillswap.UpdateProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateProfileServlet</servlet-name>
        <url-pattern>/updateProfile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewStudentProfileServlet</servlet-name>
        <servlet-class>com.skillswap.ViewStudentProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewStudentProfileServlet</servlet-name>
        <url-pattern>/viewStudentProfile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TrackExchangeStatusServlet</servlet-name>
        <servlet-class>com.skillswap.TrackExchangeStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TrackExchangeStatusServlet</servlet-name>
        <url-pattern>/trackExchangeStatus</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SearchSkillsServlet</servlet-name>
        <servlet-class>com.skillswap.SearchSkillsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchSkillsServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SendExchangeRequestServlet</servlet-name>
        <servlet-class>com.skillswap.SendExchangeRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SendExchangeRequestServlet</servlet-name>
        <url-pattern>/sendExchangeRequest</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RespondExchangeRequestServlet</servlet-name>
        <servlet-class>com.skillswap.RespondExchangeRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RespondExchangeRequestServlet</servlet-name>
        <url-pattern>/respondExchange</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CompleteExchangeServlet</servlet-name>
        <servlet-class>com.skillswap.CompleteExchangeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompleteExchangeServlet</servlet-name>
        <url-pattern>/completeExchange</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LeaveReviewServlet</servlet-name>
        <servlet-class>com.skillswap.LeaveReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaveReviewServlet</servlet-name>
        <url-pattern>/leaveReview</url-pattern>
    </servlet-mapping>

    <servlet>
    <servlet-name>SendMessageServlet</servlet-name>
    <servlet-class>com.skillswap.SendMessageServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>SendMessageServlet</servlet-name>
    <url-pattern>/sendMessage</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>DeleteUserServlet</servlet-name>
    <servlet-class>com.skillswap.DeleteUserServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DeleteUserServlet</servlet-name>
    <url-pattern>/deleteUser</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>DeleteReviewServlet</servlet-name>
    <servlet-class>com.skillswap.DeleteReviewServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DeleteReviewServlet</servlet-name>
    <url-pattern>/deleteReview</url-pattern>
</servlet-mapping>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>60</session-timeout> <!-- 60 minutes -->
    </session-config>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>SkillSwap.jsp</welcome-file>
    </welcome-file-list>

</web-app>